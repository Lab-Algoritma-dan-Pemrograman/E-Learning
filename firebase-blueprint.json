{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user information, XP, and streak data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "xp": { "type": "integer", "description": "Total experience points" },
        "level": { "type": "integer" },
        "streak": { "type": "integer" },
        "lastActive": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["admin", "user"] }
      },
      "required": ["uid", "email", "xp", "level", "streak", "lastActive", "createdAt"]
    },
    "LessonProgress": {
      "title": "Lesson Progress",
      "description": "Tracks completion status of individual lessons for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "lessonId": { "type": "string" },
        "completed": { "type": "boolean" },
        "completedAt": { "type": "string", "format": "date-time" },
        "score": { "type": "integer" }
      },
      "required": ["userId", "lessonId", "completed", "completedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/progress/{lessonId}": {
      "schema": "LessonProgress",
      "description": "Progress tracking for a specific lesson"
    }
  }
}
